#!/usr/bin/env python3
"""
generate_csharp_snippets.py

Creates a directory `csharp_snippets/` and writes a collection of C# example files
illustrating common, legitimate productivity patterns and utilities.

Run:
    python generate_csharp_snippets.py

Files produced are intended for learning and lawful use only.
"""
import os
from pathlib import Path

OUT_DIR = Path("csharp_snippets")
OUT_DIR.mkdir(exist_ok=True)

snippets = {
    "AsyncAwaitExample.cs": """using System;
using System.Net.Http;
using System.Threading.Tasks;

class AsyncAwaitExample
{
    static async Task Main()
    {
        Console.WriteLine("Starting request...");
        var content = await GetGoogleHomePageAsync();
        Console.WriteLine($"Downloaded {content.Length} characters.");
    }

    static async Task<string> GetGoogleHomePageAsync()
    {
        using var client = new HttpClient();
        return await client.GetStringAsync("https://www.example.com");
    }
}
""",
    "HttpClientHelper.cs": """using System;
using System.Net.Http;
using System.Threading.Tasks;

public static class HttpClientHelper
{
    private static readonly HttpClient _client = new HttpClient();

    public static async Task<string> GetAsync(string url)
    {
        var res = await _client.GetAsync(url);
        res.EnsureSuccessStatusCode();
        return await res.Content.ReadAsStringAsync();
    }
}
""",
    "LINQTricks.cs": """using System;
using System.Linq;
using System.Collections.Generic;

class LINQTricks
{
    static void Main()
    {
        var nums = Enumerable.Range(1, 20).ToList();
        var evens = nums.Where(n => n % 2 == 0).Select(n => n * n);
        Console.WriteLine(string.Join(", ", evens));
    }
}
""",
    "ExtensionMethods.cs": """using System;

public static class StringExtensions
{
    public static bool IsNullOrEmptyOrWhitespace(this string s)
    {
        return string.IsNullOrWhiteSpace(s);
    }
}
""",
    "FileWatcher.cs": """using System;
using System.IO;

class FileWatcherExample
{
    static void Main()
    {
        using var watcher = new FileSystemWatcher(".", "*.txt");
        watcher.Created += (s, e) => Console.WriteLine($"Created: {e.FullPath}");
        watcher.EnableRaisingEvents = true;
        Console.WriteLine("Watching current directory for .txt files. Press Enter to exit.");
        Console.ReadLine();
    }
}
""",
    "DependencyInjectionSample.cs": """using System;
using Microsoft.Extensions.DependencyInjection;

public interface IMessageService { void Send(string msg); }
public class ConsoleMessageService : IMessageService { public void Send(string msg) => Console.WriteLine(msg); }

class DISample
{
    static void Main()
    {
        var services = new ServiceCollection()
            .AddSingleton<IMessageService, ConsoleMessageService>()
            .BuildServiceProvider();

        var svc = services.GetService<IMessageService>();
        svc?.Send("Hello from DI!");
    }
}
""",
    "UnitTestTemplate.cs": """// Example NUnit test template
// Requires NUnit and a test runner (example only)
using NUnit.Framework;

[TestFixture]
public class CalculatorTests
{
    [Test]
    public void Add_ReturnsSum()
    {
        var calc = new Calculator();
        Assert.AreEqual(4, calc.Add(2,2));
    }
}

public class Calculator
{
    public int Add(int a, int b) => a + b;
}
""",
    "ReflectionUtils.cs": """using System;
using System.Reflection;

class ReflectionUtils
{
    static void Main()
    {
        var type = typeof(System.String);
        Console.WriteLine("Methods on String:");
        foreach (var m in type.GetMethods(BindingFlags.Public | BindingFlags.Instance))
        {
            Console.WriteLine(m.Name);
        }
    }
}
""",
    "RegexHelper.cs": """using System;
using System.Text.RegularExpressions;

class RegexHelper
{
    static void Main()
    {
        var input = "Order: #12345, Date: 2026-01-01";
        var m = Regex.Match(input, @"#(\\d+)");
        if (m.Success) Console.WriteLine("Order number: " + m.Groups[1].Value);
    }
}
""",
    "ParallelForEachExample.cs": """using System;
using System.Threading.Tasks;
using System.Collections.Concurrent;

class ParallelForEachExample
{
    static void Main()
    {
        var bag = new ConcurrentBag<int>();
        Parallel.ForEach(System.Linq.Enumerable.Range(1, 20), (i) =>
        {
            bag.Add(i * i);
        });
        Console.WriteLine("Computed " + bag.Count + " items.");
    }
}
""",
}

for filename, content in snippets.items():
    path = OUT_DIR / filename
    with open(path, "w", encoding="utf-8") as f:
        f.write(content)

readme = OUT_DIR / "README.txt"
readme.write_text(
    "This directory contains C# example snippets generated by generate_csharp_snippets.py.\n"
    "Use them for study and development. Build and run with `dotnet` or your preferred IDE.\n"
)

print(f"Wrote {len(snippets)} C# snippet files to {OUT_DIR.resolve()}")
